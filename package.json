{
  "name": "venuvia-scheduler",
  "version": "2.0.0",
  "private": true,
  "description": "AI booking assistant prototype: chat with an LLM that reads and changes bookings in Postgres, with user approval for every change",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:setup": "node --env-file-if-exists=.env.local scripts/db-setup.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings --test \"test/**/*.test.ts\"",
    "eval": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings scripts/eval.ts"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "luxon": "^3.7.2",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
