# Copy to .env.local and fill in. Never commit .env.local.

# Local Postgres (matches docker-compose.yml; change if you installed Postgres yourself)
DATABASE_URL=postgres://venuvia:venuvia@localhost:5432/venuvia

# Which AI to use: gemini (free tier), openrouter (free models), or anthropic (production)
AI_PROVIDER=gemini

# Gemini — free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# OpenRouter — key from https://openrouter.ai/keys; pick a free model that supports tools
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Claude (production)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Salon timezone used for all dates
# BUSINESS_TIMEZONE=Europe/Warsaw

# Give up on an AI request after this many ms (default 60000)
# AI_TIMEOUT_MS=60000
